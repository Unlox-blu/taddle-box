# App
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL [REQUIRED]
DB_HOST=localhost
DB_PORT=5432
DB_USER=taddle_box_user
DB_PASSWORD=your_db_password_here
DB_NAME=taddle_box_dev
DB_MAX_CONNECTIONS=20
# Set DB_SSL=true on production (AWS RDS enforces SSL)
DB_SSL=false
DB_CONNECTION_STRING=YOUR_DB_CONNECTION_STRING

# Redis [REQUIRED]
REDIS_URL=redis://localhost:6379

# JWT Secrets [REQUIRED — minimum 64 characters each]
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

TOKEN_SECRET=dfgvdfdassffgrrrgsvbhgxvcyufysbgvfv

ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_EXPIRES_IN=7d

VERIFICATION_TOKEN_EXPIRES_IN=1d

EMAIL_VERIFY_TOKEN_EXPIRES_IN=24h

PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Security
# bcrypt cost factor — 12 is recommended for production
BCRYPT_ROUNDS=10

#Session Management
ACCESS_TOKEN_COOKIE_MAX_AGE_SECONDS=3600000
REFRESH_TOKEN_COOKIE_MAX_AGE_SECONDS=86400000
OTP_EXPIRES_IN=600000
VALIDATE_OTP_VERIFICATION=600000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 + CloudFront [REQUIRED for media uploads]
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=taddle-box-prod
# CloudFront domain (with https://)
CLOUDFRONT_DOMAIN=https://cdn.yourapp.com

# Vimeo [REQUIRED for video uploads] 
VIMEO_CLIENT_ID=your_vimeo_client_id
VIMEO_CLIENT_SECRET=your_vimeo_client_secret
VIMEO_ACCESS_TOKEN=your_vimeo_access_token
# Optional — for validating Vimeo webhook callbacks
VIMEO_WEBHOOK_SECRET=your_vimeo_webhook_secret

# Razorpay [REQUIRED for payments]
# Use rzp_test_ prefix for test mode, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret from Razorpay dashboard — used for HMAC signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google OAuth [REQUIRED for Google sign-in]
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Client Secret
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_P8_PATH=
APPLE_P8_KEY=

# Email — AWS SES SMTP [REQUIRED for transactional emails]
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your_ses_smtp_user
EMAIL_PASS=your_ses_smtp_password
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=taddle-box

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# Upload Limits 
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

# Pagination Defaults 
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# Limitation
MIN_AGE_LIMIT=13
# PayU (REQUIRED — test credentials go here, never hardcoded in code)
PAYU_KEY=your_test_payu_key
PAYU_SALT=your_test_payu_salt
PAYU_URL=https://test.payu.in/_payment
# Public tunnel/domain PayU redirects the WebView back to (ngrok in dev)
PAYU_RETURN_BASE_URL=https://your-tunnel.ngrok-free.dev

# Withdrawal admin handoff + webhook auth (REQUIRED)
WITHDRAWAL_ADMIN_BASE_URL=https://admin.yourdomain.com
WITHDRAWAL_WEBHOOK_SECRET=change-me-to-a-long-random-string
