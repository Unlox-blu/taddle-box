{
  "expo": {
    "name": "TADDLEBOX",
    "slug": "taddlebox",
    "scheme": [
      "taddlebox",
      "com.googleusercontent.apps.457988255858-nqu9g22d1ud9lodha84jsfobvrr9ft40"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#7C3AED",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070714"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taddlebox.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Taddlebox needs Face ID to securely unlock your wallet and app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070714"
      },
      "package": "com.taddlebox.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-local-authentication",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#7C3AED",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location so you can add it to your posts and discover nearby content."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can attach images to your posts and profile.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera so you can take photos for your posts and profile."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
