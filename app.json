{
  "expo": {
    "name": "TADDLEBOX",
    "slug": "taddlebox",
    "scheme": [
      "taddlebox",
      "com.googleusercontent.apps.457988255858-nqu9g22d1ud9lodha84jsfobvrr9ft40"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070714"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taddlebox.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070714"
      },
      "package": "com.taddlebox.app"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
