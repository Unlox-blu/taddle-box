{
  "cli": {
    "version": "21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development_base": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "NODE_ENV": "development",
        "APP_ENV": "development",
        "APP_UPDATER_ENABLED": "1",
        "EXPO_PUBLIC_APP_TRACK": "development"
      }
    },
    "development": {
      "extends": "development_base",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "direct_base": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "APP_UPDATER_ENABLED": "1",
        "EXPO_PUBLIC_APP_TRACK": "production",
        "EXPO_PUBLIC_IS_DIRECT": "true",
        "NODE_ENV": "production"
      }
    },
    "direct": {
      "extends": "direct_base",
      "environment": "production"
    },
    "production_base": {
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "extends": "production_base",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
