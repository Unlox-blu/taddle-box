{
  "name": "taddle-box-api",
  "version": "1.0.0",
  "description": "Production-grade social community platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/migrate.js --seed",
    "migrate:seed": "node db/migrate.js && node db/migrate.js --seed",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@vimeo/vimeo": "^2.1.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.12.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.2",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
