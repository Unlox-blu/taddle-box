{
  "name": "taddle-box-api",
  "version": "1.0.0",
  "description": "Production-grade social community platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/migrate.js --seed",
    "migrate:seed": "node db/migrate.js && node db/migrate.js --seed",
    "reset:db": "node db/reset.js --force",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@ngrok/ngrok": "^1.7.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vimeo/vimeo": "^2.1.1",
    "adm-zip": "^0.6.0",
    "app-info-parser": "^1.1.6",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.12.0",
    "chess.js": "^1.4.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.0.0",
    "expo-server-sdk": "^3.15.0",
    "express": "^5.0.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^8.0.0",
    "ical-generator": "^11.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.12.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.2",
    "redlock": "^5.0.0-beta.2",
    "seedrandom": "^3.0.5",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "stockfish": "^18.0.8",
    "streamifier": "^0.1.1",
    "upload-files-express": "^0.4.0",
    "uuid": "^14.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "stockfish@18.0.8": true
  }
}
